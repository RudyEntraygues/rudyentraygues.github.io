{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "PowerShell(mv *)",
      "Bash(mv *)",
      "Edit",
      "Bash",
      "PowerShell"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git switch *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
